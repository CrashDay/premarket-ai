{
  "name": "premarket-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gmail:import": "node scripts/import-gmail.js",
    "fetch-links": "node scripts/fetch-links.js",
    "news": "node scripts/fetch-market-news.js",
    "candles": "node scripts/fetch-candles.js",
    "schwab:connect": "node scripts/connect-schwab.js",
    "schwab:sync": "node scripts/fetch-schwab.js",
    "verify": "node scripts/verify-candidate.js",
    "validate-order": "node scripts/validate-order.js",
    "serve": "node scripts/serve-dashboard.js",
    "brief": "node scripts/generate-report.js",
    "dashboard": "node scripts/build-dashboard.js",
    "build:core": "npm run brief && npm run news && npm run candles && npm run schwab:sync -- --soft-fail && npm run dashboard",
    "build": "npm run gmail:import && npm run build:core",
    "daily": "npm run build"
  },
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "dotenv": "^17.2.3",
    "googleapis": "^166.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
